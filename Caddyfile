# picasso — generated by `jfast workspace caddy`.
# Regenerate after adding a service; do not edit by hand.
{
	# Local development: no ACME, no certificate on first boot.
	auto_https off
}

http://localhost {
	encode zstd gzip

	# One backend, so no gateway: a second proxy would buy a hop and
	# an outage surface for nothing. The path stays /api either way.
	handle /api/* {
		uri strip_prefix /api
		reverse_proxy picasso:9800
	}

	# picasso_web: the built SPA, served as static files.
	# try_files sends unknown paths to index.html so client-side
	# routing survives a hard refresh.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	log {
		output stdout
		format json
	}
}
