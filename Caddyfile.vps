# Prueba en el VPS de prueba (2.25.196.39). Lo monta docker-compose.vps.yml.
#
# El HTTPS lo pone el Caddy del servidor y llega aquí por HTTP dentro de
# la red picasso-proxy. La app usa Caddyfile.prod tal cual, con
# PICASSO_DOMINIO=":80" en el .env; lo único propio de la prueba es la
# documentación en :8081.
{
	# Quien llega es el Caddy del servidor: se le cree el X-Forwarded-For
	# para que la API vea la IP real de cada celular. Sin esto todos
	# compartirían el límite de 20 entradas cada 5 minutos.
	servers {
		trusted_proxies static private_ranges
	}
}

import /etc/caddy/Caddyfile.prod

# La documentación del proyecto (carpeta docs/), solo para pruebas.
:8081 {
	encode zstd gzip
	root * /docs

	# Ni los generadores de los PDF ni las notas internas (mensajes clave y
	# los textos de envío, que traen el guion de venta) se publican.
	@internos path *.cjs *.md
	respond @internos 404

	header {
		X-Robots-Tag "noindex, nofollow"
		Cache-Control "no-cache"
		-Server
	}
	file_server
}
