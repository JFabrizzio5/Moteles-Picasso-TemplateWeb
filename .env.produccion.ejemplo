# Variables del .env de la raíz para producción (las lee docker compose).
# Copiar como .env en el servidor y poner valores nuevos; nunca los de la demo.
# Contraseñas: `openssl rand -hex 32` (solo letras y números: van dentro de
# una URL de conexión y un símbolo la rompería).

# Con esto, `docker compose …` usa los dos archivos sin escribir -f cada vez.
COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml

PICASSO_DOMINIO=inspecciones.motelpicasso.mx
PICASSO_DATABASE_PASSWORD=
PICASSO_REDIS_PASSWORD=

# Los secretos de la API van en picasso/.env (JFAST_AUTH_SECRET,
# JFAST_STORAGE_SIGNING_KEY y, solo el primer arranque,
# JFAST_ACCOUNTS_BOOTSTRAP_ADMIN_PASSWORD). Ver la documentación, sección
# «Variables de entorno».
