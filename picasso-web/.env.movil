# Build para probar en el teléfono (npm run movil): misma dirección que la app.
VITE_API_URL=/api
VITE_APP_NAME=Picasso

# Modo demo: en la entrada aparece un botón por puesto que entra con las cuentas
# de ejemplo de scripts/sembrar.py. La contraseña de esas cuentas queda dentro
# del JS que se descarga: SOLO para builds de demostración, nunca en producción
# (.env.production no lo trae, así que ahí el apartado no existe).
VITE_DEMO=si
VITE_DEMO_CLAVE=cambia-esta-clave
